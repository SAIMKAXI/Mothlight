{
  "expo": {
    "name": "Mothlight",
    "slug": "mothlight",
    "scheme": "mothlight",
    "version": "0.2.3",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.saimkazi.mothlight"
    },
    "android": {
      "package": "dev.saimkazi.mothlight",
      "versionCode": 4,
      "resizeableActivity": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#D4D0CD",
        "foregroundImage": "./assets/mothlight-icon.png"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/mothlight-icon.png",
          "imageWidth": 190,
          "backgroundColor": "#D4D0CD",
          "dark": {
            "image": "./assets/mothlight-icon-dark.png",
            "backgroundColor": "#1D2121"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mothlight uses Face ID to unlock your private writing space."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mothlight uses your photo library when you attach an image to a note.",
          "cameraPermission": "Mothlight uses the camera only when you choose to capture an attachment.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C2D3A9"
        }
      ]
    ],
    "icon": "./assets/mothlight-icon.png"
  }
}
